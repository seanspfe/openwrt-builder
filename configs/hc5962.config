# OpenWrt 25.12.6 (Linux 6.12.112) - ramips/mt7621 for the HiWiFi HC5962
# (极路由4, DEVICE_hiwifi_hc5962, sysupgrade.bin + factory.bin).
#
# This is a seed config, not a full .config: `make defconfig` fills in every
# default and keeps what is written here.
#
# honk is NOT part of this image: honk's build only supports the x86_64 and
# aarch64 Rust targets, and this device is mipsel_24kc (MT7621). The image
# carries LuCI with the Vantage theme and the WiFi drivers instead.

# ---------------------------------------------------------------------------
# Target: ramips / mt7621, HiWiFi HC5962 only
# ---------------------------------------------------------------------------
CONFIG_TARGET_ramips=y
CONFIG_TARGET_ramips_mt7621=y
CONFIG_TARGET_MULTI_PROFILE=y
CONFIG_TARGET_DEVICE_ramips_mt7621_DEVICE_hiwifi_hc5962=y
CONFIG_TARGET_DEVICE_PACKAGES_ramips_mt7621_DEVICE_hiwifi_hc5962=""

# ---------------------------------------------------------------------------
# LuCI + Vantage theme
# ---------------------------------------------------------------------------
CONFIG_PACKAGE_luci=y
CONFIG_PACKAGE_luci-theme-vantage=y
CONFIG_PACKAGE_luci-i18n-vantage-theme-zh-cn=y

# ---------------------------------------------------------------------------
# WiFi: MT7603EN (2.4 GHz) and MT7612EN (5 GHz), open mt76 drivers.
# Both are already DEVICE_PACKAGES of the hiwifi_hc5962 profile
# (target/linux/ramips/image/mt7621.mk); listed so the intent is on record
# and a defconfig run cannot drop one silently.
# ---------------------------------------------------------------------------
CONFIG_PACKAGE_kmod-mt7603=y
CONFIG_PACKAGE_kmod-mt76x2=y
CONFIG_PACKAGE_kmod-usb3=y

# honk stays out on purpose (unsupported architecture, see the header).
# CONFIG_PACKAGE_honk is not set
